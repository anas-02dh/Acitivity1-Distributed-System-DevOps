type Customer {
    id : ID!
    firstName : String!
    lastName : String!
    email : String!
}

input CustomerInput {
    firstName : String!
    lastName : String!
    email : String!
}

type Query {
    customers : [Customer!]!
    customerById(id: ID!): Customer
}

type Mutation {
    saveCustomer(request: CustomerInput!): Customer!
}
